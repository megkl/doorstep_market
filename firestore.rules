rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsApartment(apartmentId) {
      return signedIn()
        && get(/databases/$(database)/documents/apartments/$(apartmentId)).data.ownerId
          == request.auth.uid;
    }

    function whitelistedLandlord() {
      return signedIn()
        && request.auth.token.email != null
        && get(/databases/$(database)/documents/landlord_whitelist/$(request.auth.token.email)).data.active
          == true;
    }

    match /landlord_whitelist/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'sellerAdvertisingUntil',
          'sellerAdvertisingPurchaseId',
          'sellerSubscriptionState',
          'sellerSubscriptionVerifiedAt'
        ]);
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && (
          (request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'sellerAdvertisingUntil',
              'sellerAdvertisingPurchaseId',
              'sellerSubscriptionState',
              'sellerSubscriptionVerifiedAt'
            ]))
          || (resource.data.apartmentId != null
            && ownsApartment(resource.data.apartmentId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'apartmentId',
              'apartmentName',
              'membershipStatus',
              'updatedAt'
            ])
            && request.resource.data.membershipStatus == 'removed')
        );
      allow delete: if false;

      match /savedListings/{listingId} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == userId;
      }

      match /blockedUsers/{blockedUserId} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if signedIn()
          && request.auth.uid == userId;
        allow create: if signedIn()
          && request.resource.data.recipientId == userId
          && request.resource.data.actorId == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      allow read, update, delete: if false;
    }

    match /sellerSubscriptionTokens/{tokenHash} {
      allow read, write: if false;
    }

    match /apartments/{apartmentId} {
      allow read: if signedIn();
      allow create: if whitelistedLandlord()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if ownsApartment(apartmentId);

      match /members/{memberId} {
        allow read: if signedIn()
          && (request.auth.uid == memberId || ownsApartment(apartmentId));
        allow create: if signedIn() && request.auth.uid == memberId;
        allow update, delete: if ownsApartment(apartmentId);
      }

      match /requests/{requestId} {
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;
        allow read, update, delete: if ownsApartment(apartmentId);
      }

      match /listings/{listingId} {
        allow read: if signedIn()
          && (ownsApartment(apartmentId)
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.apartmentId
              == apartmentId);
        allow create: if signedIn()
          && request.resource.data.sellerId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.apartmentId
            == apartmentId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sellerAdvertisingUntil
            > request.time;
        allow update, delete: if signedIn()
          && (resource.data.sellerId == request.auth.uid
            || ownsApartment(apartmentId));
      }

      match /listingPrivate/{listingId} {
        allow create: if signedIn()
          && request.resource.data.sellerId == request.auth.uid;
        allow read, update, delete: if signedIn()
          && (resource.data.sellerId == request.auth.uid
            || ownsApartment(apartmentId));
      }


      match /reservations/{reservationId} {
        allow create: if signedIn()
          && request.resource.data.buyerId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.apartmentId
            == apartmentId
          && request.resource.data.askingPrice
            == get(/databases/$(database)/documents/apartments/$(apartmentId)/listings/$(request.resource.data.listingId)).data.price
          && request.resource.data.sellerId
            == get(/databases/$(database)/documents/apartments/$(apartmentId)/listings/$(request.resource.data.listingId)).data.sellerId
          && request.resource.data.sellerId != request.auth.uid
          && get(/databases/$(database)/documents/apartments/$(apartmentId)/listings/$(request.resource.data.listingId)).data.active
            == true
          && request.resource.data.status == 'pending';
        allow read: if signedIn()
          && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || ownsApartment(apartmentId));
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'collected',
            'acceptedAt',
            'declinedAt',
            'declineReason',
            'ready_for_pickupAt',
            'collectedAt',
            'cancelledAt',
            'updatedAt'
          ])
          && (
            ownsApartment(apartmentId)
            || (
              resource.data.sellerId == request.auth.uid
              && (
                (resource.data.status == 'pending'
                  && request.resource.data.status in ['accepted', 'declined'])
                || (resource.data.status == 'accepted'
                  && request.resource.data.status == 'ready_for_pickup')
                || (resource.data.status == 'ready_for_pickup'
                  && request.resource.data.status == 'collected')
              )
            )
            || (
              resource.data.buyerId == request.auth.uid
              && (
                (resource.data.status in ['pending', 'accepted']
                  && request.resource.data.status == 'cancelled')
                || (resource.data.status == 'ready_for_pickup'
                  && request.resource.data.status == 'collected')
              )
            )
          );
        allow delete: if false;
      }

      match /reviews/{reviewId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.apartmentId
            == apartmentId;
        allow create, update: if signedIn()
          && request.resource.data.reviewerId == request.auth.uid
          && request.resource.data.reservationId == reviewId
          && get(/databases/$(database)/documents/apartments/$(apartmentId)/reservations/$(reviewId)).data.buyerId
            == request.auth.uid
          && get(/databases/$(database)/documents/apartments/$(apartmentId)/reservations/$(reviewId)).data.status
            == 'collected'
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow delete: if false;
      }

      match /chats/{chatId} {
        allow create: if signedIn()
          && request.auth.uid in request.resource.data.participants
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.apartmentId
            == apartmentId;
        allow read, update: if signedIn()
          && request.auth.uid in resource.data.participants;
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/apartments/$(apartmentId)/chats/$(chatId)).data.participants;
          allow create: if signedIn()
            && request.resource.data.senderId == request.auth.uid
            && request.auth.uid in get(/databases/$(database)/documents/apartments/$(apartmentId)/chats/$(chatId)).data.participants;
          allow update, delete: if false;
        }
      }
    }
  }
}
